{
  "title": "Travel request approval",
  "blurb": "Ten clauses, two of which form a circle: Finance waits for the manager, and the manager waits for Finance.",
  "persona": "Kabir",
  "subject": "employee",
  "clauses": [
    "An employee submits a travel request to their manager at least 10 days before departure.",
    "The manager signs off requests that are within the department's travel budget.",
    "Requests above the budget are referred by the manager to Finance for clearance.",
    "Finance clears a request only after the manager has signed it off.",
    "Requests without a manager sign-off are returned by Finance to the manager.",
    "A manager cannot sign off a request above the budget until Finance has cleared it.",
    "Once a request is signed off, the Travel Desk books the tickets.",
    "For international travel, visa invitation letters will be arranged before booking.",
    "If tickets are unavailable on the requested dates, the Travel Desk proposes alternative dates to the employee.",
    "The employee accepts the alternative dates or cancels the request."
  ],
  "actors": [
    {"id": "employee", "name": "Employee"},
    {"id": "manager", "name": "Manager"},
    {"id": "finance", "name": "Finance"},
    {"id": "travel_desk", "name": "Travel Desk"}
  ],
  "facts": [
    {"id": "over_budget", "label": "the request is above the budget"},
    {"id": "manager_signoff", "label": "the manager's sign-off"},
    {"id": "finance_clearance", "label": "Finance clearance"}
  ],
  "start": "draft",
  "states": [
    {"id": "draft", "label": "Trip planned", "kind": "start", "evidence": ["c1"]},
    {"id": "manager_review", "label": "With the manager", "evidence": ["c2"]},
    {"id": "finance_review", "label": "With Finance", "evidence": ["c3"]},
    {"id": "signed_off", "label": "Signed off", "evidence": ["c7"]},
    {"id": "visa_pending", "label": "Visa letter needed", "evidence": ["c8"]},
    {"id": "visa_ready", "label": "Visa letter arranged", "evidence": ["c8"]},
    {"id": "alt_dates", "label": "Alternative dates proposed", "evidence": ["c9"]},
    {"id": "booked", "label": "Tickets booked", "kind": "terminal", "outcome": "success", "evidence": ["c7"]},
    {"id": "cancelled", "label": "Request cancelled", "kind": "terminal", "outcome": "neutral", "evidence": ["c10"]}
  ],
  "transitions": [
    {"id": "t_submit_in", "from": "draft", "to": "manager_review", "actor": "employee",
     "action": "submit a travel request within the budget",
     "deadline": "at least 10 days before departure", "evidence": ["c1"]},
    {"id": "t_submit_over", "from": "draft", "to": "manager_review", "actor": "employee",
     "action": "submit a travel request above the budget", "grants": ["over_budget"],
     "evidence": ["c1", "c3"]},
    {"id": "t_signoff", "from": "manager_review", "to": "signed_off", "actor": "manager",
     "action": "sign off a request within the budget", "forbids": ["over_budget"],
     "grants": ["manager_signoff"], "evidence": ["c2"]},
    {"id": "t_signoff_cleared", "from": "manager_review", "to": "signed_off", "actor": "manager",
     "action": "sign off an above-budget request that Finance has cleared",
     "requires": ["over_budget", "finance_clearance"], "grants": ["manager_signoff"], "evidence": ["c6"]},
    {"id": "t_refer", "from": "manager_review", "to": "finance_review", "actor": "manager",
     "action": "refer the request to Finance", "requires": ["over_budget"], "evidence": ["c3"]},
    {"id": "t_clear", "from": "finance_review", "to": "manager_review", "actor": "finance",
     "action": "clear the request", "requires": ["manager_signoff"], "grants": ["finance_clearance"],
     "evidence": ["c4"]},
    {"id": "t_return", "from": "finance_review", "to": "manager_review", "actor": "finance",
     "action": "return the request to the manager for sign-off", "forbids": ["manager_signoff"],
     "evidence": ["c5"]},
    {"id": "t_book", "from": "signed_off", "to": "booked", "actor": "travel_desk",
     "action": "book the tickets", "can_fail": true,
     "failure_label": "tickets are unavailable on the requested dates", "evidence": ["c7"]},
    {"id": "t_alt", "from": "signed_off", "to": "alt_dates", "actor": "travel_desk",
     "kind": "failure_handler", "on_failure_of": "t_book",
     "action": "propose alternative dates", "evidence": ["c9"]},
    {"id": "t_accept_alt", "from": "alt_dates", "to": "signed_off", "actor": "employee",
     "action": "accept the alternative dates", "evidence": ["c10"]},
    {"id": "t_cancel", "from": "alt_dates", "to": "cancelled", "actor": "employee", "kind": "reversal",
     "action": "cancel the request", "evidence": ["c10"]},
    {"id": "t_international", "from": "signed_off", "to": "visa_pending", "trigger": "event",
     "action": "the trip is international", "evidence": ["c8"]},
    {"id": "t_visa", "from": "visa_pending", "to": "visa_ready", "actor": null,
     "action": "arrange the visa invitation letter", "evidence": ["c8"]},
    {"id": "t_book_intl", "from": "visa_ready", "to": "booked", "actor": "travel_desk",
     "action": "book the tickets", "evidence": ["c7", "c8"]}
  ]
}
