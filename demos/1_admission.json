{
  "title": "University admission: seat acceptance and refund",
  "blurb": "An 18-clause admissions procedure. Reads fine. Traps a paying applicant in three different ways.",
  "persona": "Meera",
  "subject": "applicant",
  "clauses": [
    "An applicant who receives an offer must accept the seat on the admissions portal within 5 days of the offer.",
    "On acceptance, the seat is provisionally locked for 48 hours.",
    "The applicant must pay the seat acceptance fee through the payment page within the lock period.",
    "When a payment is initiated, the application status changes from 'Active' to 'Payment Pending' until the bank confirms the transaction.",
    "Once the bank confirms payment, the application moves to document verification.",
    "If a payment attempt fails, the applicant may retry from the payment page.",
    "The payment page is available only to applications with the status 'Active'.",
    "Applications without a confirmed payment at the end of the lock period are cancelled and the seat is released to the waiting list.",
    "The Verification Officer reviews the uploaded documents and marks them as Verified or Discrepant.",
    "If the documents are verified, the applicant is admitted.",
    "If a discrepancy is found, the applicant is notified, and discrepancies will be resolved before the review continues.",
    "If the review is not completed within 7 days of payment, the application lapses.",
    "An admitted applicant must complete enrolment by paying the first-semester fee before classes begin.",
    "An applicant may withdraw at any time before enrolment and is entitled to a refund of the fees paid, less a processing charge.",
    "Refunds are processed by the Accounts Office on submission of a No-Dues Certificate.",
    "The No-Dues Certificate is issued by the Hostel and Library offices to enrolled students.",
    "An applicant whose application was cancelled for non-payment may appeal within 3 days, provided the seat has not been released.",
    "The Admissions Committee may reinstate the application or uphold the cancellation."
  ],
  "actors": [
    {"id": "applicant", "name": "Applicant"},
    {"id": "bank", "name": "Bank"},
    {"id": "officer", "name": "Verification Officer"},
    {"id": "accounts", "name": "Accounts Office"},
